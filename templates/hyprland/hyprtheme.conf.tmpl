# ─────────────────────────────────────────────────────────────────────────────
#  Generated by HyprTheme {{ meta.version }} — theme "{{ theme.name }}"
#  {{ meta.generated_at }}
#
#  DO NOT EDIT: this file is rewritten every time a theme is applied.
#  It is sourced from your hyprland.conf; everything else in there is yours.
#  Hyprland rule syntax: {{ hyprland.syntax }}
# ─────────────────────────────────────────────────────────────────────────────

# Theme variables — use them in your own config, e.g.  col.active_border = $ht_primary
$ht_primary            = {{ colors.primary | hypr }}
$ht_secondary          = {{ colors.secondary | hypr }}
$ht_highlight          = {{ colors.highlight | hypr }}
$ht_background         = {{ colors.background | hypr }}
$ht_surface            = {{ colors.surface | hypr }}
$ht_surface2           = {{ colors.surface2 | hypr }}
$ht_text               = {{ colors.text | hypr }}
$ht_muted              = {{ colors.muted | hypr }}
$ht_border             = {{ colors.border | hypr }}
$ht_glow               = {{ colors.glow | hypr }}
$ht_gradient_start     = {{ colors.gradient_start | hypr }}
$ht_gradient_end       = {{ colors.gradient_end | hypr }}
$ht_notification       = {{ colors.notification | hypr }}
$ht_success            = {{ colors.success | hypr }}
$ht_warning            = {{ colors.warning | hypr }}
$ht_error              = {{ colors.error | hypr }}
$ht_active_border      = {{ colors.active_border | hypr }}
$ht_inactive_border    = {{ colors.inactive_border | hypr }}

general {
    gaps_in = {{ effects.gaps_in }}
    gaps_out = {{ effects.gaps_out }}
    border_size = {{ effects.border_width }}
{% if effects.gradient %}
    col.active_border = {{ colors.gradient_start | hypr }} {{ colors.active_border | hypr }} {{ colors.gradient_end | hypr }} 45deg
{% else %}
    col.active_border = {{ colors.active_border | hypr }}
{% endif %}
    col.inactive_border = {{ colors.inactive_border | hypr(0.75) }}
}

decoration {
    rounding = {{ effects.radius }}
    rounding_power = 2.0
    active_opacity = {{ derived.window_opacity_active }}
    inactive_opacity = {{ derived.window_opacity_inactive }}

    shadow {
        enabled = {{ effects.shadows | truefalse }}
        range = {{ derived.shadow_range }}
        render_power = 3
        color = {{ colors.glow | hypr(derived.shadow_alpha) }}
        color_inactive = {{ colors.background | hypr(0.5) }}
    }

    blur {
        enabled = {{ derived.blur_enabled | truefalse }}
        size = {{ derived.blur_size }}
        passes = {{ derived.blur_passes }}
        vibrancy = 0.1696
        noise = 0.0117
        popups = true
        popups_ignorealpha = 0.2
    }
}

animations {
    enabled = {{ effects.animations | yesno }}

    bezier = ht_easeOutQuint, 0.23, 1, 0.32, 1
    bezier = ht_easeInOutCubic, 0.65, 0.05, 0.36, 1
    bezier = ht_linear, 0, 0, 1, 1
    bezier = ht_almostLinear, 0.5, 0.5, 0.75, 1.0
    bezier = ht_quick, 0.15, 0, 0.1, 1

    animation = global, 1, {{ 10 | div(effects.animation_speed) | round(2) }}, default
    animation = border, 1, {{ 5.39 | div(effects.animation_speed) | round(2) }}, ht_easeOutQuint
    animation = windows, 1, {{ 4.79 | div(effects.animation_speed) | round(2) }}, ht_easeOutQuint
    animation = windowsIn, 1, {{ 4.1 | div(effects.animation_speed) | round(2) }}, ht_easeOutQuint, popin 87%
    animation = windowsOut, 1, {{ 1.49 | div(effects.animation_speed) | round(2) }}, ht_linear, popin 87%
    animation = fadeIn, 1, {{ 1.73 | div(effects.animation_speed) | round(2) }}, ht_almostLinear
    animation = fadeOut, 1, {{ 1.46 | div(effects.animation_speed) | round(2) }}, ht_almostLinear
    animation = fade, 1, {{ 3.03 | div(effects.animation_speed) | round(2) }}, ht_quick
    animation = layers, 1, {{ 3.81 | div(effects.animation_speed) | round(2) }}, ht_easeOutQuint
    animation = layersIn, 1, {{ 4 | div(effects.animation_speed) | round(2) }}, ht_easeOutQuint, fade
    animation = layersOut, 1, {{ 1.5 | div(effects.animation_speed) | round(2) }}, ht_linear, fade
    animation = fadeLayersIn, 1, {{ 1.79 | div(effects.animation_speed) | round(2) }}, ht_almostLinear
    animation = fadeLayersOut, 1, {{ 1.39 | div(effects.animation_speed) | round(2) }}, ht_almostLinear
    animation = workspaces, 1, {{ 1.94 | div(effects.animation_speed) | round(2) }}, ht_almostLinear, fade
    animation = workspacesIn, 1, {{ 1.21 | div(effects.animation_speed) | round(2) }}, ht_almostLinear, fade
    animation = workspacesOut, 1, {{ 1.94 | div(effects.animation_speed) | round(2) }}, ht_almostLinear, fade
{% if effects.rainbow_border and effects.gradient %}
    # Rotating gradient border (uses continuous rendering — costs battery)
    animation = borderangle, 1, {{ 100 | div(effects.animation_speed) | round(0) }}, ht_linear, loop
{% else %}
    animation = borderangle, 0
{% endif %}
}

{% if derived.blur_enabled %}
# Layer blur for themed shells (glass effect)
{% if hyprland.syntax == "legacy" %}
layerrule = blur, waybar
layerrule = ignorealpha 0.2, waybar
layerrule = blur, rofi
layerrule = ignorealpha 0.2, rofi
layerrule = blur, swaync-control-center
layerrule = ignorealpha 0.2, swaync-control-center
layerrule = blur, swaync-notification-window
layerrule = ignorealpha 0.2, swaync-notification-window
layerrule = blur, logout_dialog
layerrule = ignorealpha 0.2, logout_dialog
{% else %}
layerrule = match:namespace ^(waybar)$, blur on, ignore_alpha 0.2
layerrule = match:namespace ^(rofi)$, blur on, ignore_alpha 0.2
layerrule = match:namespace ^(swaync-control-center)$, blur on, ignore_alpha 0.2
layerrule = match:namespace ^(swaync-notification-window)$, blur on, ignore_alpha 0.2
layerrule = match:namespace ^(logout_dialog)$, blur on, ignore_alpha 0.2
{% endif %}
{% endif %}
{% if wallpaper.restore_on_login %}

# Restore the theme wallpaper at login (one-shot, no background service)
exec-once = {{ paths.wallpaper_restore_cmd }}
{% endif %}
