--  Generated by HyprTheme {{ meta.version }} — theme "{{ theme.name }}"
--  {{ meta.generated_at }}
--
--  DO NOT EDIT: this file is rewritten every time a theme is applied.
--  It is loaded from your hyprland.lua via require(); the rest is yours.
-- ───────────────────────────────────────────────────────────────────────────

local ht = {
  primary = "{{ colors.primary | hypr }}",
  secondary = "{{ colors.secondary | hypr }}",
  highlight = "{{ colors.highlight | hypr }}",
  background = "{{ colors.background | hypr }}",
  surface = "{{ colors.surface | hypr }}",
  text = "{{ colors.text | hypr }}",
  muted = "{{ colors.muted | hypr }}",
  border = "{{ colors.border | hypr }}",
  glow = "{{ colors.glow | hypr }}",
  active_border = "{{ colors.active_border | hypr }}",
  inactive_border = "{{ colors.inactive_border | hypr(0.75) }}",
  gradient_start = "{{ colors.gradient_start | hypr }}",
  gradient_end = "{{ colors.gradient_end | hypr }}",
}

hl.config({
  general = {
    gaps_in = {{ effects.gaps_in }},
    gaps_out = {{ effects.gaps_out }},
    border_size = {{ effects.border_width }},
    col = {
{% if effects.gradient %}
      active_border = { colors = { ht.gradient_start, ht.active_border, ht.gradient_end }, angle = 45 },
{% else %}
      active_border = ht.active_border,
{% endif %}
      inactive_border = ht.inactive_border,
    },
  },
  decoration = {
    rounding = {{ effects.radius }},
    rounding_power = 2.0,
    active_opacity = {{ derived.window_opacity_active }},
    inactive_opacity = {{ derived.window_opacity_inactive }},
    shadow = {
      enabled = {{ effects.shadows | truefalse }},
      range = {{ derived.shadow_range }},
      render_power = 3,
      color = "{{ colors.glow | hypr(derived.shadow_alpha) }}",
      color_inactive = "{{ colors.background | hypr(0.5) }}",
    },
    blur = {
      enabled = {{ derived.blur_enabled | truefalse }},
      size = {{ derived.blur_size }},
      passes = {{ derived.blur_passes }},
      vibrancy = 0.1696,
      noise = 0.0117,
      popups = true,
      popups_ignorealpha = 0.2,
    },
  },
  animations = { enabled = {{ effects.animations | truefalse }} },
})

hl.curve("ht_easeOutQuint", { type = "bezier", points = { { 0.23, 1 }, { 0.32, 1 } } })
hl.curve("ht_easeInOutCubic", { type = "bezier", points = { { 0.65, 0.05 }, { 0.36, 1 } } })
hl.curve("ht_linear", { type = "bezier", points = { { 0, 0 }, { 1, 1 } } })
hl.curve("ht_almostLinear", { type = "bezier", points = { { 0.5, 0.5 }, { 0.75, 1.0 } } })
hl.curve("ht_quick", { type = "bezier", points = { { 0.15, 0 }, { 0.1, 1 } } })

hl.animation({ leaf = "global", enabled = true, speed = {{ 10 | div(effects.animation_speed) | round(2) }}, bezier = "default" })
hl.animation({ leaf = "border", enabled = true, speed = {{ 5.39 | div(effects.animation_speed) | round(2) }}, bezier = "ht_easeOutQuint" })
hl.animation({ leaf = "windows", enabled = true, speed = {{ 4.79 | div(effects.animation_speed) | round(2) }}, bezier = "ht_easeOutQuint" })
hl.animation({ leaf = "windowsIn", enabled = true, speed = {{ 4.1 | div(effects.animation_speed) | round(2) }}, bezier = "ht_easeOutQuint", style = "popin 87%" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = {{ 1.49 | div(effects.animation_speed) | round(2) }}, bezier = "ht_linear", style = "popin 87%" })
hl.animation({ leaf = "fadeIn", enabled = true, speed = {{ 1.73 | div(effects.animation_speed) | round(2) }}, bezier = "ht_almostLinear" })
hl.animation({ leaf = "fadeOut", enabled = true, speed = {{ 1.46 | div(effects.animation_speed) | round(2) }}, bezier = "ht_almostLinear" })
hl.animation({ leaf = "fade", enabled = true, speed = {{ 3.03 | div(effects.animation_speed) | round(2) }}, bezier = "ht_quick" })
hl.animation({ leaf = "layers", enabled = true, speed = {{ 3.81 | div(effects.animation_speed) | round(2) }}, bezier = "ht_easeOutQuint" })
hl.animation({ leaf = "layersIn", enabled = true, speed = {{ 4 | div(effects.animation_speed) | round(2) }}, bezier = "ht_easeOutQuint", style = "fade" })
hl.animation({ leaf = "layersOut", enabled = true, speed = {{ 1.5 | div(effects.animation_speed) | round(2) }}, bezier = "ht_linear", style = "fade" })
hl.animation({ leaf = "workspaces", enabled = true, speed = {{ 1.94 | div(effects.animation_speed) | round(2) }}, bezier = "ht_almostLinear", style = "fade" })
{% if effects.rainbow_border and effects.gradient %}
hl.animation({ leaf = "borderangle", enabled = true, speed = {{ 100 | div(effects.animation_speed) | round(0) }}, bezier = "ht_linear", style = "loop" })
{% else %}
hl.animation({ leaf = "borderangle", enabled = false })
{% endif %}

{% if derived.blur_enabled %}
-- Layer blur for themed shells (glass effect)
hl.layer_rule({ match = { namespace = "^(waybar)$" }, blur = true, ignore_alpha = 0.2 })
hl.layer_rule({ match = { namespace = "^(rofi)$" }, blur = true, ignore_alpha = 0.2 })
hl.layer_rule({ match = { namespace = "^(swaync-control-center)$" }, blur = true, ignore_alpha = 0.2 })
hl.layer_rule({ match = { namespace = "^(swaync-notification-window)$" }, blur = true, ignore_alpha = 0.2 })
hl.layer_rule({ match = { namespace = "^(logout_dialog)$" }, blur = true, ignore_alpha = 0.2 })
{% endif %}
{% if wallpaper.restore_on_login %}

-- Restore the theme wallpaper at login (one-shot, no background service)
hl.on("hyprland.start", function()
  hl.exec_cmd("{{ paths.wallpaper_restore_cmd }}")
end)
{% endif %}
