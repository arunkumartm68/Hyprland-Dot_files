# Generated by HyprTheme {{ meta.version }} — theme "{{ theme.name }}" ({{ meta.generated_at }})
# DO NOT EDIT: rewritten on every apply.

# Theme variables (also available via hyprlock-hyprtheme.conf for custom layouts)
source = {{ paths.hyprlock_vars }}

general {
    hide_cursor = true
    grace = 0
    ignore_empty_input = true
    immediate_render = true
}

animations {
    enabled = {{ effects.animations | truefalse }}
}

background {
    monitor =
{% if wallpaper.has %}
    path = {{ wallpaper.path }}
{% else %}
    path = screenshot
{% endif %}
    color = {{ colors.background | hyprlock }}
    blur_passes = {{ components.hyprlock.blur_passes }}
    blur_size = {{ derived.blur_size | max(4) | int }}
    contrast = 0.9
    brightness = 0.7
    vibrancy = 0.17
    vibrancy_darkness = 0.0
}

# Glass card behind the login widgets
shape {
    monitor =
    size = 460, 360
    color = {{ colors.surface | hyprlock(derived.panel_alpha) }}
    rounding = {{ derived.radius_lg }}
    border_size = {{ effects.border_width }}
    border_color = {{ colors.border | hyprlock(derived.border_alpha) }}
    position = 0, 0
    halign = center
    valign = center
    zindex = 0
{% if effects.neon_glow %}
    shadow_passes = 2
    shadow_size = {{ derived.glow_px | div(2) | int }}
    shadow_color = {{ colors.glow | hyprlock(derived.glow_alpha) }}
{% endif %}
}

# Time
label {
    monitor =
{% if components.hyprlock.clock_24h %}
    text = $TIME
{% else %}
    text = $TIME12
{% endif %}
    color = {{ colors.text | hyprlock }}
    font_size = 72
    font_family = {{ fonts.ui }}
    position = 0, 95
    halign = center
    valign = center
    zindex = 1
}

# Date
label {
    monitor =
    text = cmd[update:60000] date +"%A, %d %B"
    color = {{ colors.primary | hyprlock }}
    font_size = 16
    font_family = {{ fonts.ui }}
    position = 0, 35
    halign = center
    valign = center
    zindex = 1
}

{% if components.hyprlock.show_user %}
# User
label {
    monitor =
    text =   $USER
    color = {{ colors.muted | hyprlock }}
    font_size = 14
    font_family = {{ fonts.ui }}
    position = 0, -22
    halign = center
    valign = center
    zindex = 1
}
{% endif %}

# Password field
input-field {
    monitor =
    size = 320, 50
    outline_thickness = {{ effects.border_width | max(1) | int }}
    dots_size = 0.25
    dots_spacing = 0.3
    dots_center = true
    outer_color = {{ colors.border | hyprlock(derived.border_alpha) }}
    inner_color = {{ colors.background | hyprlock(0.85) }}
    font_color = {{ colors.text | hyprlock }}
    font_family = {{ fonts.ui }}
    fade_on_empty = false
    placeholder_text = <span foreground="##{{ colors.muted | strip }}">  Enter password</span>
    check_color = {{ colors.warning | hyprlock }}
    fail_color = {{ colors.error | hyprlock }}
    fail_text = <i>$FAIL</i> <b>($ATTEMPTS)</b>
    capslock_color = {{ colors.warning | hyprlock }}
    rounding = {{ derived.radius_sm }}
    position = 0, -80
    halign = center
    valign = center
    zindex = 1
}

{% if components.hyprlock.show_battery %}
# Battery (only shown when a battery exists)
label {
    monitor =
    text = cmd[update:30000] b=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1); [ -n "$b" ] && echo "󰁹 $b%"
    color = {{ colors.battery | hyprlock }}
    font_size = 13
    font_family = {{ fonts.mono }}
    position = -{{ effects.gaps_out | add(10) | int }}, {{ effects.gaps_out | add(10) | int }}
    halign = right
    valign = bottom
    zindex = 1
}
{% endif %}

{% if components.hyprlock.show_music %}
# Now playing
label {
    monitor =
    text = cmd[update:2000] playerctl metadata --format '  {{ lit.open }}title{{ lit.close }} · {{ lit.open }}artist{{ lit.close }}' 2>/dev/null || true
    color = {{ colors.media | hyprlock }}
    font_size = 13
    font_family = {{ fonts.ui }}
    position = 0, {{ effects.gaps_out | add(10) | int }}
    halign = center
    valign = bottom
    zindex = 1
}
{% endif %}

# Keyboard layout
label {
    monitor =
    text = $LAYOUT
    color = {{ colors.muted | hyprlock }}
    font_size = 12
    font_family = {{ fonts.ui }}
    position = {{ effects.gaps_out | add(10) | int }}, {{ effects.gaps_out | add(10) | int }}
    halign = left
    valign = bottom
    zindex = 1
}
