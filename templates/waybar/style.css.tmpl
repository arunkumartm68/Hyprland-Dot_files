 *  DO NOT EDIT: rewritten on every apply. Customise the theme in HyprTheme.
 * ═══════════════════════════════════════════════════════════════════════════ */
@import url("hyprtheme-colors.css");

* {
  min-height: 0;
  min-width: 0;
  font-family: "{{ fonts.ui }}", "{{ fonts.mono }}", "Symbols Nerd Font", sans-serif;
  font-size: {{ fonts.size }}px;
  font-weight: 600;
  border: none;
  border-radius: 0;
  box-shadow: none;
  text-shadow: none;
}

window#waybar {
  background: {% if effects.glass %}{{ colors.background | rgba(derived.panel_alpha) }}{% else %}{{ colors.background }}{% endif %};
  color: {{ colors.text }};
  border-radius: {{ derived.radius_lg }}px;
  border: {{ effects.border_width }}px solid {{ colors.border | rgba(derived.border_alpha) }};
{% if effects.neon_glow %}
  box-shadow: 0 0 {{ derived.glow_px }}px {{ colors.glow | rgba(derived.glow_alpha) }};
{% endif %}
  transition-property: background-color;
  transition-duration: {{ derived.anim_ms }}ms;
}

window#waybar.hidden {
  opacity: 0.2;
}

tooltip {
  background: {{ colors.surface | rgba(0.97) }};
  color: {{ colors.text }};
  border: {{ effects.border_width }}px solid {{ colors.border | rgba(0.7) }};
  border-radius: {{ derived.radius_sm }}px;
}

tooltip label {
  color: {{ colors.text }};
}

/* ── Module cards ───────────────────────────────────────────────────────── */
#custom-launcher,
#workspaces,
#clock,
#mpris,
#network,
#bluetooth,
#pulseaudio,
#battery,
#custom-notification,
#cpu,
#memory,
#temperature,
#tray,
#custom-power,
#window {
  background: {{ colors.surface | rgba(derived.card_alpha) }};
  color: {{ colors.text }};
  border-radius: {{ derived.radius_sm }}px;
  border: 1px solid {{ colors.border | rgba(derived.card_border_alpha) }};
  padding: 0 {{ derived.pad_x }}px;
  margin: {{ derived.pad_y }}px {{ derived.module_gap }}px;
  transition: all {{ derived.anim_ms }}ms ease;
}

/* Grouped system block shares a single card */
#cpu, #memory, #temperature {
  margin-left: 0;
  margin-right: 0;
  border-radius: 0;
  border-left: none;
  border-right: none;
  color: {{ colors.system }};
}
#cpu {
  border-radius: {{ derived.radius_sm }}px 0 0 {{ derived.radius_sm }}px;
  border-left: 1px solid {{ colors.border | rgba(derived.card_border_alpha) }};
  margin-left: {{ derived.module_gap }}px;
}
#temperature {
  border-radius: 0 {{ derived.radius_sm }}px {{ derived.radius_sm }}px 0;
  border-right: 1px solid {{ colors.border | rgba(derived.card_border_alpha) }};
  margin-right: {{ derived.module_gap }}px;
}

/* ── Left ───────────────────────────────────────────────────────────────── */
#custom-launcher {
  color: {{ colors.primary }};
  font-size: {{ fonts.size | add(5) | int }}px;
  padding: 0 {{ derived.pad_x | add(2) | int }}px;
{% if effects.gradient %}
  background: linear-gradient(135deg, {{ colors.gradient_start | rgba(0.25) }}, {{ colors.gradient_end | rgba(0.25) }});
{% endif %}
}
#custom-launcher:hover {
  color: {{ colors.highlight }};
{% if effects.neon_glow %}
  box-shadow: 0 0 {{ derived.glow_px }}px {{ colors.glow | rgba(derived.glow_alpha) }};
{% endif %}
}

#workspaces {
  padding: 0 4px;
}
#workspaces button {
  color: {{ colors.workspace_inactive }};
  background: transparent;
  border-radius: {{ derived.radius_xs }}px;
  padding: 0 7px;
  margin: 3px 2px;
  min-width: 14px;
  transition: all {{ derived.anim_ms }}ms ease;
}
#workspaces button:hover {
  color: {{ colors.text }};
  background: {{ colors.surface2 | rgba(0.9) }};
}
#workspaces button.active {
  color: {{ colors.workspace_active | readable }};
{% if effects.gradient %}
  background: linear-gradient(135deg, {{ colors.gradient_start }}, {{ colors.gradient_end }});
{% else %}
  background: {{ colors.workspace_active }};
{% endif %}
{% if effects.neon_glow %}
  box-shadow: 0 0 {{ derived.glow_px | mul(0.6) | int }}px {{ colors.workspace_active | rgba(derived.glow_alpha) }};
{% endif %}
  padding: 0 12px;
}
#workspaces button.urgent {
  color: {{ colors.error | readable }};
  background: {{ colors.error }};
}
#workspaces button.empty {
  color: {{ colors.workspace_inactive | rgba(0.55) }};
}

/* ── Center ─────────────────────────────────────────────────────────────── */
#clock {
  color: {{ colors.text }};
  font-weight: 700;
}
#mpris {
  color: {{ colors.media }};
}
#mpris.paused {
  color: {{ colors.muted }};
}

/* ── Right ──────────────────────────────────────────────────────────────── */
#network {
  color: {{ colors.success }};
}
#network.disconnected,
#network.disabled {
  color: {{ colors.error }};
}
#bluetooth {
  color: {{ colors.secondary }};
}
#bluetooth.disabled,
#bluetooth.off {
  color: {{ colors.muted }};
}
#pulseaudio {
  color: {{ colors.primary }};
}
#pulseaudio.muted {
  color: {{ colors.muted }};
}
#battery {
  color: {{ colors.battery }};
}
#battery.charging,
#battery.plugged {
  color: {{ colors.success }};
}
#battery.warning:not(.charging) {
  color: {{ colors.warning }};
}
#battery.critical:not(.charging) {
  color: {{ colors.error }};
  animation-name: ht-blink;
  animation-duration: 1s;
  animation-timing-function: steps(12);
  animation-iteration-count: infinite;
  animation-direction: alternate;
}
#custom-notification {
  color: {{ colors.notification }};
}
#custom-notification.dnd-notification,
#custom-notification.dnd-none {
  color: {{ colors.muted }};
}
#tray {
  padding: 0 6px;
}
#tray > .passive {
  -gtk-icon-effect: dim;
}
#tray > .needs-attention {
  -gtk-icon-effect: highlight;
}
#custom-power {
  color: {{ colors.error }};
  font-size: {{ fonts.size | add(2) | int }}px;
}
#custom-power:hover {
  color: {{ colors.error | readable }};
  background: {{ colors.error }};
}

@keyframes ht-blink {
  to {
    background-color: {{ colors.error | rgba(0.35) }};
    color: {{ colors.text }};
  }
}
