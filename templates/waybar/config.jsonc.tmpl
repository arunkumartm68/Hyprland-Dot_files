// Generated by HyprTheme {{ meta.version }} — theme "{{ theme.name }}" ({{ meta.generated_at }})
// DO NOT EDIT: rewritten on every apply. Change component options in HyprTheme → Components.
{
  "layer": "top",
  "position": "{{ components.waybar.position }}",
  "height": {{ components.waybar.height }},
  "spacing": 0,
{% if components.waybar.floating %}
  "margin-top": {{ derived.bar_margin_top }},
  "margin-bottom": {{ derived.bar_margin_bottom }},
  "margin-left": {{ effects.window_gaps }},
  "margin-right": {{ effects.window_gaps }},
{% endif %}
  "exclusive": true,
  "passthrough": false,
  "fixed-center": true,
  "reload_style_on_change": true,
  "modules-left": [{% if components.waybar.show_launcher %}"custom/launcher", {% endif %}"hyprland/workspaces"],
  "modules-center": ["clock"{% if components.waybar.show_music %}, "mpris"{% endif %}],
  "modules-right": [
    "network",
{% if components.waybar.show_bluetooth %}
    "bluetooth",
{% endif %}
    "pulseaudio",
    "battery",
{% if components.waybar.show_notifications %}
    "custom/notification",
{% endif %}
{% if components.waybar.show_system %}
    "cpu",
    "memory",
    "temperature",
{% endif %}
    "tray",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "{{ components.waybar.launcher_icon }}",
    "tooltip": false,
    "on-click": "{{ components.waybar.launcher_command }}"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "all-outputs": true,
    "disable-scroll": false,
    "active-only": false,
    "persistent-workspaces": {},
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "clock": {
    "format": "  {:{{ components.waybar.clock_format }}}",
    "interval": 30,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1,
      "format": {
        "months": "<span color='{{ colors.text }}'><b>{}</b></span>",
        "days": "<span color='{{ colors.muted }}'>{}</span>",
        "weekdays": "<span color='{{ colors.primary }}'><b>{}</b></span>",
        "today": "<span color='{{ colors.highlight }}'><b><u>{}</u></b></span>"
      }
    }
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "dynamic-order": ["artist", "title"],
    "dynamic-len": 36,
    "player-icons": { "default": "", "spotify": "", "firefox": "" },
    "status-icons": { "paused": "" },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "tooltip-format": "{player}: {title} — {artist}"
  },

  "network": {
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-linked": "󰈀 no IP",
    "format-disconnected": "󰤮 offline",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "max-length": 18,
    "tooltip-format": "{ifname} · {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "interval": 5,
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-bluetooth": "󰂰 {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "interval": 10,
    "tooltip-format": "{timeTo}  ·  {power} W"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "cpu": {
    "format": "  {usage}%",
    "interval": 2,
    "tooltip": true
  },

  "memory": {
    "format": "  {percentage}%",
    "interval": 5,
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
  },

  "temperature": {
    "format": "  {temperatureC}°",
    "critical-threshold": 85,
    "format-critical": "  {temperatureC}°",
    "interval": 5
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": true
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "{{ paths.power_menu_cmd }}"
  }
}
