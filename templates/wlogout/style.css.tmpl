/* Generated by HyprTheme {{ meta.version }} — theme "{{ theme.name }}" ({{ meta.generated_at }})
 * DO NOT EDIT: rewritten on every apply. */
@import url("hyprtheme-colors.css");

* {
  background-image: none;
  box-shadow: none;
  font-family: "{{ fonts.ui }}", sans-serif;
}

window {
  background-color: {{ colors.background | rgba(derived.overlay_alpha) }};
}

button {
  color: {{ colors.text }};
  background-color: {{ colors.surface | rgba(derived.card_alpha) }};
  border: {{ effects.border_width }}px solid {{ colors.border | rgba(derived.card_border_alpha) }};
  border-radius: {{ derived.radius_lg }}px;
  background-repeat: no-repeat;
  background-position: center 35%;
  background-size: 32%;
  font-size: {{ fonts.size | add(3) | int }}px;
  font-weight: 600;
  margin: {{ effects.window_gaps | add(4) | int }}px;
  padding: 0 0 20px 0;
  min-width: {{ components.wlogout.button_size }}px;
  min-height: {{ components.wlogout.button_size }}px;
  outline-style: none;
  transition: all {{ derived.anim_ms }}ms ease;
}

button:focus,
button:active,
button:hover {
  color: {{ colors.primary | readable }};
{% if effects.gradient %}
  background-color: {{ colors.primary }};
  background-image: linear-gradient(135deg, {{ colors.gradient_start | rgba(0.95) }}, {{ colors.gradient_end | rgba(0.95) }});
{% else %}
  background-color: {{ colors.primary }};
{% endif %}
  border-color: {{ colors.primary }};
{% if effects.neon_glow %}
  box-shadow: 0 0 {{ derived.glow_px | mul(1.5) | int }}px {{ colors.glow | rgba(derived.glow_alpha) }};
{% endif %}
}

#lock {
  background-image: image(url("{{ paths.wlogout_icons }}/lock.svg"));
}
#lock:hover, #lock:focus {
  background-image: image(url("{{ paths.wlogout_icons }}/lock-hover.svg"));
}

#logout {
  background-image: image(url("{{ paths.wlogout_icons }}/logout.svg"));
}
#logout:hover, #logout:focus {
  background-image: image(url("{{ paths.wlogout_icons }}/logout-hover.svg"));
}

#suspend {
  background-image: image(url("{{ paths.wlogout_icons }}/suspend.svg"));
}
#suspend:hover, #suspend:focus {
  background-image: image(url("{{ paths.wlogout_icons }}/suspend-hover.svg"));
}

#reboot {
  background-image: image(url("{{ paths.wlogout_icons }}/reboot.svg"));
}
#reboot:hover, #reboot:focus {
  background-image: image(url("{{ paths.wlogout_icons }}/reboot-hover.svg"));
}

#shutdown {
  background-image: image(url("{{ paths.wlogout_icons }}/shutdown.svg"));
}
#shutdown:hover, #shutdown:focus {
  background-image: image(url("{{ paths.wlogout_icons }}/shutdown-hover.svg"));
}
