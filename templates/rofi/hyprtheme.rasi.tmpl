/* Generated by HyprTheme {{ meta.version }} — theme "{{ theme.name }}" ({{ meta.generated_at }})
 * DO NOT EDIT: rewritten on every apply.  Loaded via @theme from config.rasi. */

configuration {
    modi:               "drun,run,window";
    show-icons:         {{ components.rofi.show_icons | truefalse }};
    icon-theme:         "{{ components.rofi.icon_theme }}";
    display-drun:       "";
    display-run:        "";
    display-window:     "";
    drun-display-format: "{name}";
    font:               "{{ fonts.ui }} 12";
    hover-select:       true;
    me-select-entry:    "";
    me-accept-entry:    "MousePrimary";
}

* {
    ht-primary:     {{ colors.primary }};
    ht-secondary:   {{ colors.secondary }};
    ht-highlight:   {{ colors.highlight }};
    ht-background:  {{ colors.background | hexa(derived.panel_alpha) }};
    ht-surface:     {{ colors.surface | hexa(derived.card_alpha) }};
    ht-surface2:    {{ colors.surface2 }};
    ht-text:        {{ colors.text }};
    ht-muted:       {{ colors.muted }};
    ht-border:      {{ colors.border | hexa(derived.border_alpha) }};
    ht-selected-fg: {{ colors.highlight | readable }};

    background-color:   transparent;
    text-color:         @ht-text;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

window {
    location:           center;
    anchor:             center;
    width:              {{ components.rofi.width }}px;
    border:             {{ effects.border_width }}px;
    border-color:       @ht-border;
    border-radius:      {{ derived.radius_lg }}px;
    background-color:   @ht-background;
    cursor:             "default";
}

mainbox {
    padding:            {{ derived.pad_lg }}px;
    spacing:            {{ derived.pad_md }}px;
    children:           [ "inputbar", "message", "listview" ];
}

inputbar {
    padding:            {{ derived.pad_md }}px {{ derived.pad_lg }}px;
    spacing:            {{ derived.pad_md }}px;
    border:             0px 0px 2px 0px;
    border-color:       @ht-primary;
    border-radius:      {{ derived.radius_sm }}px;
    background-color:   @ht-surface;
    children:           [ "prompt", "entry" ];
}

prompt {
    text-color:         @ht-primary;
    font:               "{{ fonts.ui }} 13";
}

entry {
    placeholder:        "{{ components.rofi.prompt }}";
    placeholder-color:  @ht-muted;
    cursor:             text;
}

message {
    border-radius:      {{ derived.radius_sm }}px;
    background-color:   @ht-surface;
    padding:            {{ derived.pad_sm }}px {{ derived.pad_md }}px;
}

textbox {
    text-color:         @ht-muted;
}

listview {
    columns:            {{ components.rofi.columns }};
    lines:              {{ components.rofi.lines }};
    cycle:              true;
    dynamic:            true;
    scrollbar:          false;
    layout:             vertical;
    spacing:            {{ derived.pad_xs }}px;
    fixed-height:       false;
}

element {
    padding:            {{ derived.pad_sm }}px {{ derived.pad_md }}px;
    spacing:            {{ derived.pad_md }}px;
    border-radius:      {{ derived.radius_sm }}px;
    cursor:             pointer;
}

element normal.normal,
element alternate.normal {
    background-color:   transparent;
    text-color:         @ht-text;
}

element normal.urgent,
element alternate.urgent {
    text-color:         {{ colors.error }};
}

element normal.active,
element alternate.active {
    text-color:         @ht-secondary;
}

element selected.normal,
element selected.active,
element selected.urgent {
{% if effects.gradient %}
    background-image:   linear(135, {{ colors.gradient_start }}, {{ colors.gradient_end }});
{% else %}
    background-color:   @ht-highlight;
{% endif %}
    text-color:         @ht-selected-fg;
}

element-icon {
    size:               1.6em;
    vertical-align:     0.5;
    cursor:             inherit;
}

element-text {
    vertical-align:     0.5;
    text-color:         inherit;
    cursor:             inherit;
}

error-message {
    padding:            {{ derived.pad_lg }}px;
    border-radius:      {{ derived.radius_lg }}px;
    background-color:   @ht-background;
    text-color:         {{ colors.error }};
}
