/* ═══════════════════════════════════════════════════════════════════════════
 *  Generated by HyprTheme {{ meta.version }} — theme "{{ theme.name }}"
 *  {{ meta.generated_at }}
 *  DO NOT EDIT: rewritten on every apply.
