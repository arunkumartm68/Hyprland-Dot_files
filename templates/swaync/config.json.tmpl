{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": {{ effects.window_gaps }},
  "control-center-margin-bottom": {{ effects.window_gaps }},
  "control-center-margin-right": {{ effects.window_gaps }},
  "control-center-margin-left": {{ effects.window_gaps }},
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": {{ components.swaync.width }},
  "control-center-height": 720,
  "notification-window-width": {{ components.swaync.width }},
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": {{ derived.anim_ms }},
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "text-empty": "No notifications",
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "inhibitors",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear all",
      "clear-all-button": true
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "when-available",
      "loop-carousel": true,
      "image-size": 72,
      "image-radius": {{ derived.radius_sm }}
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃠"
    },
    "buttons-grid": {
      "buttons-per-row": 5,
      "actions": [
        { "label": "󰤨", "command": "nm-connection-editor", "type": "normal" },
        { "label": "󰂯", "command": "blueman-manager", "type": "normal" },
        { "label": "󰕾", "command": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle", "type": "toggle", "update-command": "wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && echo true || echo false" },
        { "label": "󰍬", "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle", "type": "toggle", "update-command": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo true || echo false" },
        { "label": "󰐥", "command": "{{ paths.power_menu_cmd }}", "type": "normal" }
      ]
    }
  }
}
